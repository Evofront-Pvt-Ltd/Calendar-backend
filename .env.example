EMAIL_PROVIDER=sendgrid

SENDGRID_EMAIL_ENABLED=true
SENDGRID_API_KEY=your_calendarappointments_subaccount_api_key_here
SENDGRID_MAIL_SEND_URL=https://api.sendgrid.com/v3/mail/send
SENDGRID_FROM_EMAIL=mukesh.g@evofront.com
SENDGRID_FROM_NAME=Calendar Booking
SENDGRID_REPLY_TO_EMAIL=mukesh.g@evofront.com

SENDGRID_TEMPLATE_ID=
SENDGRID_VERIFICATION_TEMPLATE_ID=
SENDGRID_PASSWORD_RESET_TEMPLATE_ID=
SENDGRID_MEETING_INVITATION_TEMPLATE_ID=
