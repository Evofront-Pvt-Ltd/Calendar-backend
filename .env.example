ENVIRONMENT=development
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=calendar_booking
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 characters outside development or startup fails.
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_MINUTES=15
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
APPLICATION_BASE_URL=http://127.0.0.1:3000
ORGANIZATION_ID=default
ORGANIZATION_EMAIL_DOMAIN=evofront.com

EMAIL_ENABLED=true
EMAIL_PROVIDER=sendgrid
NOTIFICATIONS_ENABLED=true
IN_APP_NOTIFICATIONS_ENABLED=true
DEFAULT_PRODUCT_TIMEZONE=Asia/Kolkata
DEFAULT_SUPPORT_START_TIME=00:00
DEFAULT_SUPPORT_END_TIME=00:00
DEFAULT_APPOINTMENT_DURATION_MINUTES=30
PUBLIC_BOOKING_MODE=instant
BOOKING_NOTIFICATION_EMAIL=admin@example.com
BOOKING_FROM_NAME=Calendar Booking
BOOKING_REPLY_TO_ENABLED=true

