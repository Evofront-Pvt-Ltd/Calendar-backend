# Apply this ClusterIssuer ONLY if `kubectl get clusterissuer letsencrypt-prod`
# reports that it does not exist. The Pods Civo cluster already uses this issuer
# name. Replace REPLACE_WITH_ADMIN_EMAIL before applying.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
  labels:
    app.kubernetes.io/part-of: calendar
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: REPLACE_WITH_ADMIN_EMAIL
    privateKeySecretRef:
      name: letsencrypt-prod-account-key
    solvers:
      - http01:
          ingress:
            class: nginx
